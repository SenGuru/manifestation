@using Framework.Infrastructure.Utils
@using CodeGenerator

<div class="px-4 py-2 vagn-list-screen-wrapper">
<div class="page-header px-3 py-2 bg-white">
  <div class="d-flex align-items-center">
      <div class="col-sm-auto">
          <!-- Page title -->
          <h3 class="card-title mb-0 flex-grow-1" id="vagncart-@(Model.SmallDashEntityName)-page-title">
              @(Model.SplitetCapitalizeEntityName)s
          </h3>
      </div>
     <!-- add @(Model.SmallEntityName) btn -->
      <div class="d-flex justify-content-sm-end col-sm"> 
          <button type="button" class="btn btn-sm vagn-btn-sm btn-primary" data-bs-toggle="modal" id="create-@(Model.SmallDashEntityName)-btn" (click)="showAdd@(Model.CapitalizeEntityName)Modal();">
                 <i-tabler name="plus" class="tabler-icon-sm tabler-icon-stroke-white mx-1"></i-tabler> 
                 Add @(Model.SplitetCapitalizeEntityName)
           </button>
      </div>
  </div>
</div>
<div class="card mb-2 pt-2">
<div class="card-header pt-2">
<form @("#")@(Model.SmallEntityName)Search="ngForm"
  novalidate
  focusOnError
  (ngSubmit)="onSearch(@(Model.SmallEntityName)Search)"
>
 
  <div class="row">
    <div class="col-md-2 pr-0">
      <input
        type="text"
        class="form-control"
        name="@(Model.SmallDashEntityName)-search-input"
        placeholder="Search Text"
        [(ngModel)]="this.searchModel.keyword"
      />
    </div>
@foreach(var p in Model.SearchCriteriaType.GetProperties())
{
    var pName = p.Name;

    var pNameWithOutTypeId = p.Name.Replace("TypeId","");
    var pLNameWithOutTypeId = StringUtils.MakeFirstCharAsLower(pNameWithOutTypeId);
    var pCamelNameWithOutTypeId = StringUtils.SplitCamelCase(pNameWithOutTypeId);                
    var pNameWithOutTypesId = p.Name.Replace("TypeIds","");                
    var pLNameWithOutTypesId= StringUtils.MakeFirstCharAsLower(pNameWithOutTypesId);

    var pNameWithOutId = p.Name.Replace("Id","");
    var pLNameWithOutId = StringUtils.MakeFirstCharAsLower(pNameWithOutId);
    var pCamelNameWithOutId = StringUtils.SplitCamelCase(pNameWithOutId);
    
    var pNameWithOutIds = p.Name.Replace("Ids","");
    var pLNameWithOutIds = StringUtils.MakeFirstCharAsLower(pNameWithOutIds);
    var pCamelNameWithOutIds = StringUtils.SplitCamelCase(pNameWithOutIds);

    var pLName = StringUtils.MakeFirstCharAsLower(p.Name);
    var pCamelName = StringUtils.SplitCamelCase(pName);
    var pCamelLName = StringUtils.SplitCamelCase((pLName));

    if (p.Name == (Model.EntityType.Name+"Id"))
	  {
      continue;
    }   	
	else if (CodeGenUtils.IsPropertyIgnoreForSearchFilter(p.Name))
	  {
      continue;
    }
	else if (p.Name == "StateId" || (p.Name == "SelectedId"))
	 {
      continue;
    }
    else if (p.Name.StartsWith("Predefined") && p.Name.EndsWith("TypeIds"))
	  {
    <div class="col-md-2 pr-0">
      <ng-select placeholder="@(pCamelNameWithOutIds)" name="selected@(pNameWithOutIds)s" id="selected@(pNameWithOutIds)s" bindLabel="type" [items]="@(pLNameWithOutIds)s" [clearable]="true"
      [multiple]="true" [(ngModel)]="selected@(pNameWithOutIds)s">
        <ng-template ng-multi-label-tmp let-items="items" let-clear="clear">
          <div class="ng-value" *ngFor="let item of selected@(pNameWithOutIds)s | slice:-1:1">
            <span class="ng-value-label">{{item.type}}</span>
            <span class="ng-value-icon right" (click)="clear(item)" aria-hidden="true">×</span>
          </div>
          <div class="ng-value" *ngIf="items.length > 1">
            <span class="ng-value-label">{{items.length - 0}} Selected...</span>
          </div>
        </ng-template>
      </ng-select>
    </div>
    }
    else if (p.Name.StartsWith("Predefined") && p.Name.EndsWith("TypeId"))
	  {
    <div class="col-md-2">
      <ng-select class="ng-select" [items]="(pNameWithOutId)s" placeholder="@(pCamelNameWithOutId)" [clearable]="true" name="selected@(pNameWithOutId)" id="selected@(pNameWithOutId)" bindLabel="type"
                      [(ngModel)]="selected@(pNameWithOutId)">
      </ng-select>
    </div> 
    }
        else if (p.Name.EndsWith("Ids"))
	  {
      <div class="col-md-2">
      <ng-select placeholder="@(pNameWithOutIds)" name="selected@(pNameWithOutId)s" id="selected@(pNameWithOutId)s" bindLabel="@(pLNameWithOutId)Name"
       [items]="@(pLNameWithOutIds)s" [clearable]="true" [multiple]="true"
       [typeahead]="@(pLNameWithOutId)Typeahead$" [loading]="@(pLNameWithOutId)TypeaheadLoading" [(ngModel)]="selected@(pNameWithOutId)s" >
      <ng-template ng-multi-label-tmp let-items="items" let-clear="clear">
        <div class="ng-value" *ngFor="let item of selected@(pNameWithOutId)s | slice:-1:1">
          <span class="ng-value-label">{{item.@(pLNameWithOutId)Name}}</span>
          <span class="ng-value-icon right" (click)="clear(item)" aria-hidden="true">×</span>
        </div>
        <div class="ng-value" *ngIf="items.length > 1">
          <span class="ng-value-label">{{items.length - 0}} Selected...</span>
        </div>
      </ng-template>
    </ng-select>
    </div>
      }
        else if (p.Name.EndsWith("Id"))
	  {
    <div class="col-md-2">
      <ng-select placeholder="@(pCamelNameWithOutId)" name="selected@(pNameWithOutId)" id="selected@(pNameWithOutId)" bindLabel="@(pLNameWithOutId)Name"
       [items]="@(pLNameWithOutId)s" [clearable]="true" [typeahead]="@(pLNameWithOutId)Typeahead$" [loading]="@(pLNameWithOutId)TypeaheadLoading"
       [(ngModel)]="selected@(pNameWithOutId)">
    </ng-select>
    </div>      
      }
      else
      {
      }      
}
    <div class="d-flex justify-content-sm-end col-sm">
      <button type="submit" class="btn btn-sm vagn-btn-sm btn-primary search" data-bs-toggle="modal" id="user-search-btn"><i class="ri-search-line align-bottom me-1"></i> Search</button>
      <button type="button" (click)="onReset(@(Model.SmallEntityName)Search)"  class="btn btn-sm vagn-btn-sm bg-light">
        Reset
      </button>
    </div>
  </div>
</form>
</div>

<div class="table-responsive mb-1 vagn-table" id="vagncart-@(Model.SmallDashEntityName)-page-table">
<table class="table card-table table-vcenter text-nowrap datatable table-striped" *ngIf="listData.length > 0; else nodata">
  <thead class="vagn-table-header">
   <tr>
       <th *ngFor="let column of columns" class="text-left" [ngClass]="{
                      'w-1': column.value === 'action',
                      'table-header': column.sortable
                    }" (click)="changeSort(column)">
            <span class="mr-1" [innerHTML]="column.text"></span>
            <i [ngClass]="searchModel.sortBy === column.value ? 'fa fa-sort-' + currentSort : ''"></i>
          </th>
          <th class="text-left w-1">
            <span class="mr-1">ACTION</span>
          </th>
        </tr>
  </thead>
  <tbody>
    <tr *ngFor="let item of listData">
	@foreach(var p in Model.EntityType.GetProperties())
    {
    var pNameWithFirstLetterUC = p.Name.Replace("Id","");
    var pNameWithFirstLetterLC = StringUtils.MakeFirstCharAsLower(pNameWithFirstLetterUC);
    var propName = p.Name;
    var formatValue = "";	
    if (p.Name == (Model.EntityType.Name+"Id"))
	{
        continue;
    }
    else if (p.Name == "CreatedByUserId" || p.Name == "CreatedDate" || p.Name == "IsDeleted")
	{
        continue;
    }
    else if (p.Name == "ModifiedByUserId")
	{
@:      <td class="text-left">
@:        {{ item.modifiedByUserFirstName }} {{ item.modifiedByUserLastName }}
@:      </td>
        continue;
    } else if(p.Name.StartsWith("Predefined") && p.Name.EndsWith("TypeId")) {
 @:      <td>  
 @:        <span class="badge bg-{{enumViewService.get@(pNameWithFirstLetterUC)Class(item.@(pNameWithFirstLetterLC)Id)}}-subtle text-{{enumViewService.get@(pNameWithFirstLetterUC)Class(item.@(pNameWithFirstLetterLC)Id)}}"
 @:       >{{ item.@(pNameWithFirstLetterLC)Name  }}</span>
 @:      </td>
        continue;
    }
    else if (p.Name.EndsWith("TypeId"))
	{
        propName = p.Name.Replace("TypeId","TypeName");
    }
    else if (p.Name.EndsWith("TypeIds"))
	{
        propName = p.Name.Replace("TypeIds","TypeName");
    }
    else if (p.Name.EndsWith("Id"))
	{
        propName = p.Name.Replace("Id","Name");
    }
    if (p.Name == (Model.EntityType.Name+"Id"))
	{
        continue;
    }
    else if (p.Name.EndsWith("TypeId"))
	{
        propName = p.Name.Replace("TypeId","TypeName");
    }
    else if (p.Name.EndsWith("TypeIds"))
	{
        propName = p.Name.Replace("TypeIds","TypeName");
    }
    else if (p.Name.EndsWith("Id"))
	{
        propName = p.Name.Replace("Id","Name");
    }
	else if (p.Name.ToLower().Contains("date") || p.Name.ToLower().Contains("time"))
	{
        formatValue = "|  date: " +  "\'" + "MM/dd/yy" + "\'";
    }
	
@:      <td class="text-left">
@:        {{ item.@(StringUtils.MakeFirstCharAsLower(propName)) @Raw(@formatValue) }}
@:      </td>
  }
     
        <td class="text-left">
            <div class="action-col-wrap">
              <span class="mx-1">
                <a class="cursor-pointer" (click)="showView@(Model.CapitalizeEntityName)Modal(item)">
                  <span class="text-dark" title="View User">
                    <i-tabler name="eye" class="tabler-icon-sm tabler-icon-stroke-gray"></i-tabler>
                  </span>
                </a>
              </span>
              <span class="mx-1">
                <a class="cursor-pointer" (click)="showUpdate@(Model.CapitalizeEntityName)Modal(item)">
                  <span class="text-dark" title="Edit User">
                    <i-tabler name="edit" class="tabler-icon-sm tabler-icon-stroke-gray"></i-tabler>
                  </span>
                </a>
              </span>
              <span class="mx-1">
                <a class="cursor-pointer" (click)="delete@(Model.CapitalizeEntityName)(item)">
                  <span class="text-dark" title="Delete User">
                    <i-tabler name="trash" class="tabler-icon-sm tabler-icon-stroke-gray"></i-tabler>
                  </span>
                </a>
              </span>
            </div>
          </td> 
    </tr>
  </tbody>
</table>
<ng-template #nodata>
<app-no-data-found></app-no-data-found>
</ng-template>
</div>
<app-pagination
#pagination
[totalItems]="totalItems" [currentPage]="searchModel.page"
(pageOptionChanged)="paginationChange($event)"
></app-pagination>
</div>
</div>