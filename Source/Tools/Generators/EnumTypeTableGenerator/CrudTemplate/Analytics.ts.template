  }


  listCallbackFunction(thisObjParam){
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    const search = %name%%typeName%DashboardSearchCriteria.getCopy(thisObj.searchCriteria,true);
    if(thisObj.selectedReportMonth && thisObj.selectedReportMonth.id === ReportMonthTypes.CustomMonthType){
      search.startDate = thisObj.fromDate;
      search.endDate = thisObj.endDate;
    }
    else if(thisObj.selectedReportMonth && thisObj.selectedReportMonth.id === ReportYearTypes.CustomYearType){
      search.startDate = thisObj.fromDate;
      search.endDate = thisObj.endDate;
    }
    IBaseAnalyticsSearchCriteria.fixDateForSending(search);
    let http : HttpService = thisObj.httpService;
    http.%modelListFunctionName%(search).subscribe(result =>{
      if(!result.isSuccess){
        return;
      }
      thisObj.listData = result.model;
      thisObj.listDataTotalRecord = result.totalRecords;
    })
  }

  
}
