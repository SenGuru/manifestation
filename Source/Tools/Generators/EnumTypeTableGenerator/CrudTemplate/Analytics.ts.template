    IBaseAnalyticsSearchCriteria.fixDateForSending(search);
   
    thisObj.httpService.%monthlyFunctionName%(search).subscribe(result =>{
      if(!result.isSuccess){
        return;
      }
      thisObj.chartData = result.model;
      thisObj.chartValues = thisObj.chartService.get%returnModel%By%name%ChartOptions(thisObj.chartData,ReportTypes.Monthly);
    })
  }

  weeklyCallbackFunction(thisObjParam){
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    const search = %name%%typeName%DashboardSearchCriteria.getCopy(thisObj.searchCriteria,true);
    IBaseAnalyticsSearchCriteria.fixDateForSending(search);
    thisObj.httpService.%weeklyFunctionName%(search).subscribe(result =>{
      if(!result.isSuccess){
        return;
      }
