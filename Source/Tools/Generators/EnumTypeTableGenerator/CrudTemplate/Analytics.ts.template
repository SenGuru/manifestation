  dailyCallbackFunction(thisObjParam){
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    const search = %name%%typeName%DashboardSearchCriteria.getCopy(thisObj.searchCriteria,true);
    thisObj.httpService.%dailyFunctionName%(search).subscribe(result =>{
      if(!result.isSuccess){
        return;
      }
      thisObj.chartData = result.model;
      thisObj.chartValues = thisObj.chartService.get%returnModel%By%name%ChartOptions(thisObj.chartData,ReportTypes.CustomDateRange);
    })
  }

  monthlyCallbackFunction(thisObjParam){
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    const search = %name%%typeName%DashboardSearchCriteria.getCopy(thisObj.searchCriteria,true);
    if(thisObj.selectedReportMonth && thisObj.selectedReportMonth.id === ReportMonthTypes.CustomMonthType){
      search.startDate = thisObj.fromDate;
      thisObj.endDate =endOfMonth(thisObj.endDate);
      search.endDate = thisObj.endDate;
