  filterNameCallbackFunction(thisObjParam) : string{
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    let statusAsString = "";
    if(thisObj.selected%name%Type.length > 0){
      statusAsString = thisObj.selected%name%Type.length > 2 ? thisObj.selected%name%Type.slice(0,2).map(status => status.type).join(',') + " ..." 
      : thisObj.selected%name%Type.map(status => status.type).join(',');

    }
    return statusAsString;
  }

  newSearchCriteriaCreateCallbackFunction(thisObjParam) {
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    return new %name%%typeName%DashboardSearchCriteria();
  }

  searchCriteriaUpdateCallbackFunction(thisObjParam) {
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    if(thisObj.selected%name%Type.length > 0 ){
      thisObj.searchCriteria.%returnModelWithSmallFirstLetter%TypeIds = thisObj.selected%name%Type.map(status => status.id);
