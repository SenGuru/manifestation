  templateUrl: './analytics-%returnModelSmall%-by-%splittedFileName%-screen.html'
})
export class Analytics%returnModel%By%name%ScreenComponent extends BaseAnalyticsScreenComponent<Analytics%returnModel%By%name%ScreenComponent,%name%%typeName%DashboardSearchCriteria,%returnModel%By%name%%typeName%StatsModel,%returnModel%Model> implements OnInit {

  search%name%Types: Status[]=[];
  selected%name%Type: Status[]=[];
  columns:OppantTableColumn[]= ListColumns.%returnModelWithSmallFirstLetter%Columns;
