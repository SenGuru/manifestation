  yearlyCallbackFunction(thisObjParam){
    let thisObj = thisObjParam as Analytics%returnModel%By%name%ScreenComponent;
    const search = %name%%typeName%DashboardSearchCriteria.getCopy(thisObj.searchCriteria,true);
    if(thisObj.selectedReportMonth && thisObj.selectedReportMonth.id === ReportYearTypes.CustomYearType){
      search.startDate = thisObj.fromDate;      
      search.endDate = endOfYear(thisObj.endDate);  
    }
    IBaseAnalyticsSearchCriteria.fixDateForSending(search);
    thisObj.httpService.%yearlyFunctionName%(search).subscribe(result =>{
      if(!result.isSuccess){
        return;
      }
      thisObj.chartData = result.model;
      thisObj.chartValues = thisObj.chartService.get%returnModel%By%name%ChartOptions(thisObj.chartData,ReportTypes.Yearly);
