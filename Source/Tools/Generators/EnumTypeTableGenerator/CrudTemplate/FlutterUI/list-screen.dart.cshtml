  Future<void> onDelete@(Model.CapitalizeEntityName)(@(Model.CapitalizeEntityName)Model? @(camelCaseTableName)) async {
    var confirmation = await showConfirmationDialog(context, "Confirmation",
        "Are you sure, you want to delete @(splittedTableNameBySpace) - ${@(camelCaseTableName)?.@(camelCaseTableName)Name}");
    if (confirmation) {
      try {
        EasyLoading.show(status: "Loading..");
                                    if (@(camelCaseTableName) == null) {
          return showErrorDialog(context, "@(splittedTableNameBySpace) Code is required");
        }

        final @(camelCaseTableName)DeleteResult = await _apiService
            .mark@(Model.CapitalizeEntityName)AsDeleted(id: @(camelCaseTableName).@(camelCaseTableName)Id);
             

        if (@(camelCaseTableName)DeleteResult == null) {
          _loggerService.writeLog(
              "delete@(Model.CapitalizeEntityName): Unable to delete @(splittedTableNameBySpace)",
              LogMessageLevel.error);
          showErrorDialog(context, "Unable to delete @(splittedTableNameBySpace)");

          return;
        } @("else if ") (!@(camelCaseTableName)DeleteResult.success) {
          _loggerService.writeLog(
              "delete@(Model.CapitalizeEntityName): Unable to delete @(splittedTableNameBySpace) - ${@(camelCaseTableName)DeleteResult.errorMsg}",
              LogMessageLevel.error);
          showErrorDialog(context,
              "Unable to delete @(splittedTableNameBySpace) - ${@(camelCaseTableName)DeleteResult.errorMsg}");
          return;
        }

        await showSuccessDialog(context, "Successfully @(splittedTableNameBySpace) deleted");
        onReset@(Model.CapitalizeEntityName)();
      } catch (e, stackTrace) { 
        _loggerService.writeLog("create@(Model.CapitalizeEntityName): Unable to delete @(splittedTableNameBySpace)",
            LogMessageLevel.error, e, stackTrace);
        showErrorDialog(context, "Unable to delete @(splittedTableNameBySpace)");
      } finally {
        
       EasyLoading.dismiss();
    }
    }
