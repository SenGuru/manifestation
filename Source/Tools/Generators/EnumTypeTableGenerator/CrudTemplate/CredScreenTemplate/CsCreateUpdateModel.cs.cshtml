@:
}
@{
    i = 0;
}
@foreach (var t in Model.Code.Sections)
{
        //if(i > breakAfter)
        //    continue;
        i ++;
        addedColumns.Clear();
    @:public class @(t.ViewClassName)CreateUpdateModel
    @:{
        @:public CredStepInfoModel StepInfo { get; set; }
@:
    @foreach (var c in t.AllColumns)
    {
            var arrStr = "";
            var arrEndStr = "";
            if (c.IsArray)
            {
                arrStr = "List<";
                arrEndStr = ">";
            }
            else if (c.IsNull && (c.DataType != CodeGenerator.CSharpDataTypes.FKey || c.DataType != CodeGenerator.CSharpDataTypes.File || c.DataType != CodeGenerator.CSharpDataTypes.Unknown || c.DataType != CodeGenerator.CSharpDataTypes.@string) )
            {
                if(c.DataType == CodeGenerator.CSharpDataTypes.@string)
                {
                    arrEndStr = "";
                }
                else
                {
                arrEndStr = "?";
                }
            }

            var withoutId = c.DbColumnName.Replace("Id", "");
            bool withNameExists = t.AllColumns.Any(x => x.DbColumnName == withoutId + "Name");

            if (c.IsFkey)
            {
                    if (c.ElementType == CodeGenerator.ElementTypes.File)
                    {
                    @foreach (var cf in c.FileRelatedColumnsForView)
                    {                    
        @:public @(cf.DataType) @(cf.FileColumn) { get; set; } // 1 -@*@(c.ToString())*@
@:
        addedColumns.Add(cf.FileColumn);
                    }
                    }
                    else
                    {
                    if (c.ControlType == CodeGenerator.ControlTypes.MultiSelect || c.ParentTable.IsList)
                        {
                            if (c.DbColumnName.EndsWith("MetaDataIds"))
                            {
        @:public @Raw(arrStr+"long"+arrEndStr) Existing@(c.DbColumnName) { get; set; }//2 -@(c.ToString())
        addedColumns.Add(c.DbColumnName);
@:
        @:public @Raw(arrStr+"long"+arrEndStr) New@(c.DbColumnName) { get; set; }//2 -@*@(c.ToString())*@
        addedColumns.Add(c.DbColumnName);
                            }
                            else
                            {
                                if(c.ElementType != CodeGenerator.ElementTypes.LookupList)
                                {
        @:public @Raw(arrStr+c.FKeyTypeName+"UpdateModel"+arrEndStr) Existing@(c.DbColumnName) { get; set; }//2.1 -@*@(c.ToString())*@
        addedColumns.Add(c.DbColumnName);
@:        
        @:public @Raw(arrStr+c.FKeyTypeName+"CreateModel"+arrEndStr) New@(c.DbColumnName) { get; set; }//2.1 -@*@(c.ToString())*@
        addedColumns.Add(c.DbColumnName);
                                }
                                else
                                {
        @:public @Raw(arrStr+"long"+arrEndStr) Existing@(c.DbColumnName) { get; set; }//2.1.1 -@*@(c.ToString())*@
        addedColumns.Add(c.DbColumnName);
@:
        @:public @Raw(arrStr+"long"+arrEndStr) New@(c.DbColumnName) { get; set; }//2.1.1 -@*@(c.ToString())*@
        addedColumns.Add(c.DbColumnName);
                                }
                            }
                        }
                        else
                        {
        @:public @Raw(arrStr + "long" + arrEndStr) @(c.DbColumnName) {get ; set;}//2.2 -@*@(c.ToString())*@
        addedColumns.Add(c.DbColumnName);
                        }
                    }
            }
            else
            {
                if (c.TsDataType == CodeGenerator.TsDataTypes.fKey)
                {
                    if (addedColumns.Any(x => x == c.DbColumnName))
                    {
                        continue;
                    }
        @:public @Raw(arrStr + "long" + arrEndStr) @(c.DbColumnName) { get; set; }//3 -@*@(c.ToString())*@
                }
                else
                {
                    if (addedColumns.Any(x => x == c.DbColumnName))
                    {
                        continue;
                    }
        @:public @Raw(arrStr + c.DataType + arrEndStr) @(c.DbColumnName) { get; set; } // 5 -@*@(c.ToString())*@
    addedColumns.Add(c.DbColumnName);
                }
            }
@:
    }
    @:}
@:
}
