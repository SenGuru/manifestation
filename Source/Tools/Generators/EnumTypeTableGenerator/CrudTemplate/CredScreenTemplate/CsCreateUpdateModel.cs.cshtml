    @:{
foreach(var c in t.Columns)
{
    if (c.IsArray)
    {
        if(c.ElementType == CodeGenerator.ElementTypes.MetaDataWithChild || c.ElementType == CodeGenerator.ElementTypes.MetaData)
        {
        @:protected List<long> Existing@(c.DbColumnNameWithoutIds)s { get; set; }
