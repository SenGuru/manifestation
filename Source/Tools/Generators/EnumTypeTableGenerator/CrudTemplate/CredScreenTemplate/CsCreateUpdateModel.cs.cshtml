    {
        if(c.ElementType == CodeGenerator.ElementTypes.MetaDataWithChild || c.ElementType == CodeGenerator.ElementTypes.MetaData)
        {
        @:public List<MetaDataModel> @(c.DbColumnNameWithoutIds)s { get; set; }
@:
        }
        else
        {
        @:public List<@(c.FKeyTypeName)Model> @(c.DbColumnNameWithoutIds)s { get; set; }
@:
        }
    }
    else if (c.IsFkey)
    {
        @://public @c.FKeyTypeName @c.DbColumnNameWithoutId { get; set; }
@:
    }    
}
    @:}
@:
