  onSubmit(f: NgForm) {
    if (!f.valid) {
      const element = document.getElementById('main');
      if (element) {
        setTimeout(() => {
          element.scrollIntoView({ behavior: 'smooth', block: 'start', inline: 'nearest' });
        }, 0);
      }
      return;
    };
    //   if (this.files === null) {
    //     this.isErrorFiles = true;
    //      return;
    // }
    let @(smallClassName)Model = this.generateModel(f.value);
    if (this.isCreateMode) {
      this.create@(className)(@(smallClassName)Model);
    }
    else {
      this.update@(className)(@(smallClassName)Model);
    }
  }

