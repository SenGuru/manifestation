@{
    string GetShowHideFunction(Column col)
    {
        if (col.ApplicableTo == ApplicableToUITypes.All)
        {
            return "showFieldsAll";
        }
        else if (col.ApplicableTo == ApplicableToUITypes.Pr)
        {
            return "showFieldsIndividual";
        }
        else if (col.ApplicableTo == ApplicableToUITypes.Or)
        {
            return "showFieldsOrganization";
        }
        else if (col.ApplicableTo == ApplicableToUITypes.ATypical)
        {
            return "showFieldsAType";
        }
        else if (col.ApplicableTo == ApplicableToUITypes.PrAndOr)
        {
            return "showFieldsIndividualAndOrganization";
        }        
        throw new Exception($"Invalid ApplicableTo value {col.ApplicableTo}");
    }
}