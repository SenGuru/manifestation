@model List<(string Name, string DashName)>

<div class="tab-content">
    <!-- page start-->
    <form #lvProviderForm="ngForm" appFocusOnError novalidate >
        <div class="row">
            <div class="col-sm-3 group-control" >
            <label class="form-label">Npi Type <span class="required-sign">&nbsp;*</span></label>
            <div>
              <ng-select [items]="npiTypes" #lvProviderType="ngModel" id="selectedNpiType" name="selectedNpiType"
                [ngClass]="{ 'error': lvProviderForm.submitted && lvProviderType.invalid }" [(ngModel)]="selectedNpiType"  (change)="changeNpiType(selectedNpiType)"
                [clearable]="false" bindLabel="type" required placeholder="Provider Type">
              </ng-select>
              <div class="error-msg">
                <h4><small>
                    <span class="text-danger" *ngIf="(lvProviderForm.submitted) && lvProviderType.errors?.required">
                      npi  is required
                    </span></small></h4>
              </div>
            </div>
          
          </div>
        </div>
@foreach(var c in Model)
{
@:        <div class="form-group row mt-3">
@:            <div class="col-sm-3 group-control">
@:                <div class="mt-3 mb-n2">
@:                    <button type="button" class="btn btn-primary ml-2 btn-sm mr-1 h-fit pull-right" (click)="showAddCase@(c.Name)Modal()">
@:                        Add
@:                    </button>
@:                </div>
@:                <label class="form-label"> New label
@:                </label>
@:            </div>
@:        </div>
@:
}

    </form>
</div>