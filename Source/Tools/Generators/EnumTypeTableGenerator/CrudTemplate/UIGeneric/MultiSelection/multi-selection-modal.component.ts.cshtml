 public get@(Model.CapitalizeEntityName)s(searchModel: @(Model.CapitalizeEntityName)SearchCriteria): void {
    searchModel.companyId = this.companyId;
    this.httpService.get@(Model.CapitalizeEntityName)s(searchModel).subscribe({
      next: result => {
      if(!result.isSuccess) {
        this.dialogService.errorWithReturnModel("Unable to get @(Model.SplitetCapitalizeEntityName)s", result);
        return;
      }

      if(result.model) {
       this.listData = result.model;
       this.totalItems = result.totalRecords ??  0;
      }
     },
    error: (err) => this.dialogService.error("Unable to get @(Model.SplitetCapitalizeEntityName)s"),
    complete: () => null,
  });
  }
   
 public checkboxOnClick(item: @(Model.CapitalizeEntityName)Model, selectedIndex: number): void {
    const checkArray: UntypedFormArray = this.form?.get('checkArray') as UntypedFormArray;
    this.selectedCheckBox[selectedIndex] = !this.selectedCheckBox[selectedIndex];
    const selectedCheckboxValue = +item.@(Model.SmallEntityName)Id;
    const index = checkArray.controls.findIndex(list => list.value === selectedCheckboxValue);
    if (index == -1) {
      checkArray.push(new UntypedFormControl(selectedCheckboxValue));
    } else {
      let i = 0;
       //@@ts-expect-error the following line can contains an error
      checkArray.controls.forEach((item: UntypedFormControl) => {
        if (item.value == selectedCheckboxValue) {
          checkArray.removeAt(i);
          return;
        }
        i++;
      });
    }
  }
  
  public onSubmit(f: NgForm): void {
     // eslint-disable-next-line @@typescript-eslint/no-unsafe-assignment, no-unsafe-optional-chaining
    const { checkArray } = this.form?.value;
    if (checkArray?.length == 0) {
      this.dialogService.error('Please select atleast one Movie Shoot Day.');
    } else {
      // eslint-disable-next-line @@typescript-eslint/no-unsafe-call
      const selected@(Model.CapitalizeEntityName)Ids: number[] = checkArray?.map((id: unknown) => Number(id)) as number[]; 
      if(this.onCloseCallback) this.onCloseCallback(selected@(Model.CapitalizeEntityName)Ids);
    }
  }
   


