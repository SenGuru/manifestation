	    {
            @:this.searchModel.@(StringUtils.MakeFirstCharAsLower(p.Name)) = null;
        }
        else if (p.Name.EndsWith("TypeIds"))
	    {
            @:this.searchModel.@(StringUtils.MakeFirstCharAsLower(p.Name)) = null;
        }
	    else if (p.Name.EndsWith("Id"))
	    {
          @:this.searchModel.@(StringUtils.MakeFirstCharAsLower(p.Name)) =  null;
        }
     }
    this.get@(Model.CapitalizeEntityName)s(this.searchModel);
  }

   public changeSort(header: AstroClassColumnModel): void {
    this.crudService.baseChangeSort(header,this.searchModel,{ currentSort : this.currentSort });
    this.currentSort = this.searchModel.sortAscending ? 'up': 'down';
    this.get@(Model.CapitalizeEntityName)s(this.searchModel);
  }

  public paginationChange(e: BaseSearchCriteria): void {
      this.searchModel.page = e.page;
      this.searchModel.pageSize = e.pageSize;
      this.get@(Model.CapitalizeEntityName)s(this.searchModel);
  }

  
  public cancel(): void {
     // eslint-disable-next-line @@typescript-eslint/no-unsafe-assignment, no-unsafe-optional-chaining
    const { checkArray } = this.form?.value;
    if (checkArray?.length > 0) {
      this.dialogService
        .cancelConfirmWithTitle(
          'Discard the changes?',
          'If you proceed you cannot undo later',
          'cancel'
        )
        .then((res) => {
          if (!res) return;
          this.activeModal.close();
        });
    } else {
      this.activeModal.close();
    }
  }
}
