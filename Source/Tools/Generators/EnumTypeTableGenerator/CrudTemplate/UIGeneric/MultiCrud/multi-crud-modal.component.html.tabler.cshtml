@using Framework.Infrastructure.Utils
@using CodeGenerator

<form name="form" @("#")lv@(Model.CapitalizeEntityName)Form="ngForm" appFocusOnError
      (ngSubmit)="lv@(Model.CapitalizeEntityName)Form.form.valid && onSubmit(lv@(Model.CapitalizeEntityName)Form)">
    <div class="modal-header bg-light p-3" *ngIf="!isFullScreenMode">
        <h5 class="modal-title" id="vagncart-@(Model.SmallDashEntityName)-modal-title">
            {{title}}<span *ngIf="isSuperAdmin">
                -
                {{companyName}}
            </span>
        </h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cancel"
                id="vagncart-@(Model.SmallDashEntityName)-modal-cancel-btn" (click)="cancel(true)"></button>
    </div>
    <div [ngClass]="isFullScreenMode ? '' : 'modal-body'"
         [ngStyle]="!isFullScreenMode ? {'height': 'calc(100vh - 260px)', 'overflow-y': 'auto'} : {'':''}">
        <div class="d-flex justify-content-sm-end col-sm mb-3">
            <button type="button" class="btn btn-sm vagn-btn-sm btn-success" (click)="add@(Model.CapitalizeEntityName)();"
                    data-bs-toggle="modal" id="create-@(Model.SmallDashEntityName)-btn">
                <i class="ri-add-line align-bottom me-1"></i> Add {{ screenText }}
            </button>
        </div>

        <div class="@(Model.SmallDashEntityName)-container" *ngFor="let @(Model.SmallEntityName) of @(Model.SmallEntityName)List; let i = index">
            <div class="card bg-light">
                <div class="card-header bg-light">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <h6 class="card-title mb-0">
                                @(Model.SplitetCapitalizeEntityName) #{{i+1}}
                            </h6>
                        </div>
                        <div class="flex-shrink-0">
                            <ul class="list-inline card-toolbar-menu d-flex align-items-center mb-0">
                                <li class="list-inline-item">
                                    <a class="align-middle minimize-card" data-bs-toggle="collapse" href="javascript:void(0);"
                                       (click)="minimize(i)" role="button" aria-expanded="false"
                                       [attr.aria-controls]="'collapseContent' + i">
                                        <i class="mdi mdi-plus align-middle plus"></i>
                                        <i class="mdi mdi-minus align-middle minus"></i>
                                    </a>
                                </li>
                                <li class="list-inline-item">
                                    <button type="button" (click)="deleteItem(@(Model.SmallEntityName), i)" class="btn-close fs-10 align-middle"></button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-body collapse" [ngClass]="@(Model.SmallEntityName).isCollapsed ? 'hide' : 'show'" id="collapseContent{{i}}">
                    <div class="@(Model.SmallDashEntityName)-container" [ngClass]="isFullScreenMode ? 'row' : ''">
                        <div class="form-group row mb-4" [ngClass]="isFullScreenMode ? 'col-sm-12' : ''">
                             @{
                                var i = -1;
                            }
