  public onSubmit(f: NgForm): void {
    if (!f.valid) {
      return;
    }

    const multiple@(Model.CapitalizeEntityName)CreateModel = new Multiple@(Model.CapitalizeEntityName)CreateModel();
    multiple@(Model.CapitalizeEntityName)CreateModel.new@(Model.CapitalizeEntityName)s = [];

    for (const data of this.@(Model.SmallEntityName)List) {
      const @(Model.SmallEntityName) = new @(Model.CapitalizeEntityName)CreateModel();
      Object.assign(@(Model.SmallEntityName) , data);
      multiple@(Model.CapitalizeEntityName)CreateModel.new@(Model.CapitalizeEntityName)s.push(@(Model.SmallEntityName) );
    }
    this.create@(Model.CapitalizeEntityName)(multiple@(Model.CapitalizeEntityName)CreateModel);
  }

  public create@(Model.CapitalizeEntityName)(obj: Multiple@(Model.CapitalizeEntityName)CreateModel): void {
    if (!ObjectUtils.isNullOrUndefined(obj)) {
      this.httpService.createMultiple@(Model.CapitalizeEntityName)(obj, getHeaderWithLoadingText("Saving ...")).subscribe({
        next: (result) => {
          if (!result.isSuccess) {
            this.dialogService.errorWithReturnModel('Not Able to Create @(Model.CapitalizeEntityName)', result);
            return;
          }
          this.dialogService.success('Successfully Created the @(Model.CapitalizeEntityName).');
          this.activeModal.close();
          if (this.onCloseCallback) this.onCloseCallback();
        },
        error: (err: unknown) => this.dialogService.error('Not Able to create @(Model.CapitalizeEntityName)'),
        complete: () => null,
      });
    }
  }

 public cancel(checkDirty: boolean): void {

    if (!checkDirty && this.onCloseCallback) this.onCloseCallback();

    if (this.form.dirty && checkDirty) {
      this.dialogService.cancelConfirmWithTitle('Discard the changes?', 'If you proceed, you cannot undo later.', 'Discard').then(res => {
        if (res)
          return this.activeModal.close();
      });
    }
    else {
      this.activeModal.close();
    }
  }
 
