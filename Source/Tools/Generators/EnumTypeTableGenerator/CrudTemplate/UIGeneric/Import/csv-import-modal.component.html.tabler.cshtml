@using Framework.Infrastructure.Utils
@using CodeGenerator

<div>
    <div class="modal-header bg-light p-3">
        <h5 class="modal-title" id="vagncart-csv-dialoge-title">{{title}} {{currentStep === 1 ? '1' : '2'}}/2</h5>
        <button type="button" id="vagncart-csv-dialoge-close-btn" class="btn-close" (click)="cancel(true)"></button>
    </div>
    <form #form="ngForm" novalidate appFocusOnError (ngSubmit)="onSubmit(form)">
        <div class="modal-body" style="height:calc(100vh - 190px);">
            <div class="m-3 pt-1" *ngIf="currentStep === 1">
                <h5 class="text-left pb-2 mt-3">Chooose file to Import</h5>
                <div class="row justify-content-center">
                    <div class="col-md-12 mt-2">
                        <div class="input-group">
                            <input type="file" class="form-control" id="csvFileFile" accept=".csv" required #fileInput
                                (change)="uploadFile($event)">
                        </div>
                        <div class="mt-1">
                            <span class="text-danger text-center ml-2" *ngIf="isErrorFiles ">
                                {{isErrorFiles ? "File is Required":"" }}
                            </span>
                        </div>
                    </div>
                </div>
                <div class="text-left mt-4 cursor-pointer text-primary">
                    <a style="text-decoration:underline;" (click)="downloadSampleFile()">Click here to download the
                        Sample Import file</a>
                </div>
            </div>
           
            <div *ngIf="currentStep !== 1">

                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-sm-end col-sm gap-2">
                            
                    @foreach(var p in Model.SearchCriteriaType.GetProperties())
                    {
                        var pName = p.Name;

                        var pNameWithOutTypeId = p.Name.Replace("TypeId","");
                        var pLNameWithOutTypeId = StringUtils.MakeFirstCharAsLower(pNameWithOutTypeId);
                        var pCamelNameWithOutTypeId = StringUtils.SplitCamelCase(pNameWithOutTypeId);                
                        var pNameWithOutTypesId = p.Name.Replace("TypeIds","");                
                        var pLNameWithOutTypesId= StringUtils.MakeFirstCharAsLower(pNameWithOutTypesId);

                        var pNameWithOutId = p.Name.Replace("Id","");
                        var pLNameWithOutId = StringUtils.MakeFirstCharAsLower(pNameWithOutId);
                        var pCamelNameWithOutId = StringUtils.SplitCamelCase(pNameWithOutId);
    
                        var pNameWithOutIds = p.Name.Replace("Ids","");
                        var pLNameWithOutIds = StringUtils.MakeFirstCharAsLower(pNameWithOutIds);
                        var pCamelNameWithOutIds = StringUtils.SplitCamelCase(pNameWithOutIds);

                        var pLName = StringUtils.MakeFirstCharAsLower(p.Name);
                        var pCamelName = StringUtils.SplitCamelCase(pName);
                        var pCamelLName = StringUtils.SplitCamelCase((pLName));

                        if (p.Name == (Model.EntityType.Name+"Id"))
	                      {
                          continue;
                        }   	
	                    else if (CodeGenUtils.IsPropertyIgnoreForSearchFilter(p.Name))
	                      {
                          continue;
                        }
	                    else if (p.Name == "StateId" || (p.Name == "SelectedId") || p.Name == "CompanyId" || p.Name.StartsWith("Predefined") && p.Name.EndsWith("TypeIds") || p.Name.StartsWith("Predefined") && p.Name.EndsWith("TypeId"))
	                     {
                          continue;
                        }
                            else if (p.Name.EndsWith("Ids") || p.Name.EndsWith("Id"))
	                      {
                              <button type="button" class="btn btn-success btn-sm vagn-btn-sm"  (click)="showAdd@(pNameWithOutId)Modal();" data-bs-toggle="modal" id="create-@(pNameWithOutId)-btn"><i class="ri-add-line align-bottom me-1"></i> Add @(pCamelNameWithOutId)</button>
 
                          }
                          else
                          {
                          }      
                    }
                        </div>
                    </div>

                 </div>

                 
                    <div class="tab-content">
                        <div class="table-responsive vagncart-table-report-summary">
                            <table
                                class="table table-hover table-outline table-vcenter text-nowrap card-table table-striped"
                                *ngIf="tableData.length > 0 else nodata">
                                <thead class="opnt-table-header">
                                    <tr>

                                        <th class="text-left">
                                            <label class="form-check m-0 pr-0">

                                                <input type="checkbox" [checked]="isChooseAll"
                                                    (change)="chooseAllList()" class="form-check-input" /><span
                                                    class="form-check-label"></span></label>
                                        </th>
                                        <th class="text-left" *ngFor="let column of headerList"
                                            [ngStyle]="{'width' : column.width, 'display' : column.show ? '' : 'none'}">
                                            {{ column.text }}
                                        </th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <tr *ngFor="let @(Model.SmallEntityName) of @(Model.SmallEntityName)s; let i = index">

                                        <td class="text-left">
                                            <label class="form-check m-0 pr-0">
                                                <input type="checkbox" [checked]="selectedCheckBox[i]"
                                                    (change)="onCheckboxChange($event, @(Model.SmallEntityName), i)" [value]="@(Model.SmallEntityName)"
                                                    class="form-check-input" /><span
                                                    class="form-check-label"></span></label>
                                        </td>
