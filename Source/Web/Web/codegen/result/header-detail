/// In header details ts config screen

    @Output() showChangeTab: EventEmitter<string> = new EventEmitter<string>();
    selectedMovieShootDayConfigScreenType: MovieShootDayConfigScreenTabTypes;
              
    changeTab(tab: MovieShootDayConfigScreenTabTypes) {
      this.showChangeTab.emit(tab);
      this.selectedMovieShootDayConfigScreenType = tab;
    }
    
