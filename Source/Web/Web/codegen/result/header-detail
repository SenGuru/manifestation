/// In header config ts config screen

 ///// member initialization

  selectedMovieShootDayConfigScreenType: MovieShootDayConfigScreenTabTypes;
  
showShootDaySummaryListScreen: boolean = false;
showMovieShootDayListScreen: boolean = false;
showMovieShootDayBudgetListScreen: boolean = false;
showMovieShootDayExpenseListScreen: boolean = false;

  changeTab(tab: MovieShootDayConfigScreenTabTypes) {
    this.resetTabs();
    this.selectedMovieShootDayConfigScreenType = tab;
  

        if (tab == 'summary') {
          this.showShootDaySummaryListScreen = true;
        }
 else if (tab == 'movie-shoot-days') {
            this.showMovieShootDayListScreen = true;
        }
 else if (tab == 'shoot-day-budget') {
            this.showMovieShootDayBudgetListScreen = true;
        }
 else if (tab == 'shoot-day-expense') {
            this.showMovieShootDayExpenseListScreen = true;
        }

    }
  resetTabs() {
    
this.showShootDaySummaryListScreen = false;
this.showMovieShootDayListScreen = false;
this.showMovieShootDayBudgetListScreen = false;
this.showMovieShootDayExpenseListScreen = false;

    }

/////////////////////////////////////////////////////
In custom-model.ts
export type MovieShootDayConfigScreenTabTypes: summary | movie-shoot-days | shoot-day-budget | shoot-day-expense;
