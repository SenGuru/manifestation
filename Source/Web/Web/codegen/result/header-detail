/// In header config screen
<div class="tab-container">
             
          
  
            <div *ngIf="showShootDaySummaryListScreen">
              <app-shoot-day-summary-list-screen
               [isSuperAdmin]="isSuperAdmin"
                [isMovieShootDayConfig]="true" [companyId]="companyId" [companyName]="companyName"></app-shoot-day-summary-list-screen>
            </div>  
  
            <div *ngIf="showMovieShootDayListScreen">
              <app-movie-shoot-day-list-screen
               [isSuperAdmin]="isSuperAdmin"
                [isMovieShootDayConfig]="true" [companyId]="companyId" [companyName]="companyName"></app-movie-shoot-day-list-screen>
            </div>  
  
            <div *ngIf="showMovieShootDayBudgetListScreen">
              <app-movie-shoot-day-budget-list-screen
               [isSuperAdmin]="isSuperAdmin"
                [isMovieShootDayConfig]="true" [companyId]="companyId" [companyName]="companyName"></app-movie-shoot-day-budget-list-screen>
            </div>  
  
            <div *ngIf="showMovieShootDayExpenseListScreen">
              <app-movie-shoot-day-expense-list-screen
               [isSuperAdmin]="isSuperAdmin"
                [isMovieShootDayConfig]="true" [companyId]="companyId" [companyName]="companyName"></app-movie-shoot-day-expense-list-screen>
            </div>  


        </div>
