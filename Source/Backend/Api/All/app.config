<configuration>
   <runtime>
      <gcServer enabled="true"/>
   </runtime>

  <system.webServer>
    <security>
          <requestFiltering>
             <verbs allowUnlisted="false">
                <add verb="GET" allowed="true" />
                <add verb="POST" allowed="true" />
                <add verb="HEAD" allowed="true" />
             </verbs>
          </requestFiltering>
       </security>
  <modules>        
    <remove name="WebDAVModule" />    
  </modules>    
  <handlers>        
    <remove name="WebDAV" />    
  </handlers>
</system.webServer>

</configuration>
