@model Framework.Utilities.PocoGenerator.TemplateData
@functions
{
    public static string GetNullableValueAsString(bool value)
    {
        if (value == true)
            return "true";
        return "false";
    }

    public static string AsString(string value)
    {
        return value;
    }

    public static string GetIdentity(DatabaseSchemaReader.DataSchema.DatabaseColumn col)
    {
        if (col.IsAutoNumber)
            return ".Identity()";
        return "";
    }

    public static string GetNullable(DatabaseSchemaReader.DataSchema.DatabaseColumn col)
    {
        if (col.Nullable)
            return ".Nullable()";
        return ".NotNullable()";
    }

    public static string GetPrimaryKey(DatabaseSchemaReader.DataSchema.DatabaseTable tbl, DatabaseSchemaReader.DataSchema.DatabaseColumn col)
    {
        if (col.IsPrimaryKey)
        {
            if (tbl.PrimaryKey == null)
                return ".PrimaryKey()";
            else
                return $".PrimaryKey(\"{tbl.PrimaryKey.Name}\")";
        }
        return "";
    }

    public static string GetColSize(DatabaseSchemaReader.DataSchema.DatabaseColumn col)
    {
        if (col.DataType.IsString && col.Length > 0)
            return col.Length.ToString();
        else if(col.DataType.IsString && col.Length == -1)
            return Int32.MaxValue.ToString();

        return "";
    }

    public static string GetSchemaCode(string schema, List<string> inbuiltSchema)
    {
        if (inbuiltSchema.Contains(schema.ToUpper()))
            return "";
        else
            return $".InSchema(\"{schema}\")";
    }
    
    public static string GetSchemaString(string schema, List<string> inbuiltSchema)
    {
        if (inbuiltSchema.Contains(schema.ToUpper()))
            return "";
        else
            return $"{schema})";
    }
}
